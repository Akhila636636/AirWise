# AirWise Environment Variables

# Groq API key (required for LLM-powered plans; rule engine works without it)
GROQ_API_KEY=gsk_your_key_here

# Groq model (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Server port (optional, defaults to 3001)
PORT=3001

# CORS allowed origins (comma-separated, defaults to http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Node environment
NODE_ENV=development
